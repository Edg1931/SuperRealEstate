# Client-side config for the Unity app (safe to ship: anon key is public by design).
# Copy to .env and fill in. NEVER put service-role keys or third-party API keys
# here — those live as Supabase Edge Function secrets, server-side only.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# Server-side only (set via `supabase secrets set`, do NOT commit):
# PLANTNET_API_KEY=...
# RENTCAST_API_KEY=...
# REGRID_API_KEY=...
